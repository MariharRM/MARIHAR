# MARIHAR Environment Configuration Example
# Copy this file to .env and modify the values as needed

# Optional: Custom path to yt-dlp executable
# If not set, the application will use the bundled yt-dlp in Binaries/ folder
# Example: YTDLP_PATH=C:\Users\YourName\Tools\yt-dlp.exe
YTDLP_PATH=

# Optional: Custom downloads directory
# If not set, downloads will go to the system's Downloads folder
# Example: DOWNLOADS_DIR=C:\Users\YourName\Videos\MARIHAR
DOWNLOADS_DIR=

# Optional: Port for the Flask development server
# Default: 5000
FLASK_PORT=5000

# Optional: Flask debug mode (development only)
# Set to 1 to enable debug mode (not recommended for production)
FLASK_DEBUG=0

# Optional: Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO
